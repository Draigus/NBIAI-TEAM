   // Walk segments in order; each cd changes the effective cwd
   let resolved = cwd;
   for (const seg of segments) {
-    const cdMatch = seg.match(/^cd\s+(.+)$/i);
+    const cdMatch = seg.match(/^(?:cd|chdir|sl|set-location|pushd)\s+(?:-path\s+)?(.+)$/i);
     if (cdMatch) {
